{
    "serverInfo": {
        "name": "Anthropic-Agents",
        "title": "Anthropic Agents",
        "version": "1.0.0",
        "websiteUrl": "https://docs.anthropic.com/en/api/agents",
        "description": "Create, update, archive, and manage Anthropic Managed Agents with flat primitive mutation tools. GET discovery is exposed through MCP resources and resource templates."
    },
    "plugins": [
        "MCPhappey.Tools.Anthropic.Agents.AnthropicAgents, MCPhappey.Tools"
    ],
    "obo": {
        "graph.microsoft.com": "https://graph.microsoft.com/User.Read https://graph.microsoft.com/Sites.ReadWrite.All"
    },
    "headers": [
        {
            "name": "x-api-key",
            "value": "{anthropic_api_key}",
            "description": "Anthropic API key for agent management",
            "isRequired": true,
            "variables": {
                "anthropic_api_key": {
                    "description": "Your Anthropic API key",
                    "isRequired": true,
                    "isSecret": true,
                    "placeholder": "Enter your Anthropic API key"
                }
            }
        }
    ]
}
