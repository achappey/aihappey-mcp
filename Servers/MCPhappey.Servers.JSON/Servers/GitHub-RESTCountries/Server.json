{
  "serverInfo": {
    "name": "GitHub-RESTCountries",
    "title": "GitHub RESTCountries.NET",
    "version": "1.0.0",
    "websiteUrl": "https://github.com/egbakou/RESTCountries.NET",
    "description": "Country lookup: names, codes, flags, population, currencies and languages.",
    "icons": [
      {
        "src": "https://api.nuget.org/v3-flatcontainer/restcountries.net/3.5.0/icon"
      }
    ]
  },
  "plugins": [
    "MCPhappey.Tools.GitHub.RestCountries.CountryService, MCPhappey.Tools"
  ],
  "tools": {
    "github_rest_countries_render_countries_widget": {
      "_meta": {
        "ui": {
          "resourceUri": "ui://widget/countries.html",
          "visibility": [
            "model",
            "app"
          ]
        }
      }
    },
    "github_rest_countries_render_country_widget": {
      "_meta": {
        "ui": {
          "resourceUri": "ui://widget/country-detail.html",
          "visibility": [
            "model",
            "app"
          ]
        }
      }
    }
  }
}